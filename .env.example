# One OpenAI-compatible client. Default: Anthropic. For OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
AGENT_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-sonnet-4-6
OPTIMIZER_MODEL=claude-sonnet-4-6
EUR_PER_USD=0.86

# Langfuse: optional. Silent when unset; enables traces when set. Use a dedicated project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Evals and loop
EVAL_SEED=42
FEEDBACK_WEIGHT=2
BUDGET_MIN_GAIN_PER_EUR=0.03
MAX_ITERATIONS=12
MAX_TOTAL_EUR=10

# TypeSafe Jev (System One). Optional for evals and loop (models.jev = null without it);
# required by evals/generate.py. Pin the versioned id: aliases move on every release.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_REFUSED_MIN_CONF=0.6
JEV_LEAK_MIN=0.7
JEV_GEN_MIN_CONF=0.8
JEV_GEN_MIN_NOUL=0.8
JEV_GEN_MAX_DUP=0.3
